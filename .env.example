# Copiar a .env y ajustar. No commitear .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://commerce:commerce@localhost:5432/commerce_core

APP_ORIGIN=http://localhost:5173
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Commerce Core <no-reply@commerce-core.local>
SESSION_TTL_DAYS=7

# Administrador general de la plataforma, creado por `pnpm db:seed`
PLATFORM_ADMIN_EMAIL=admin@commerce-core.local
PLATFORM_ADMIN_PASSWORD=change-me-now-please

# Puerto de la API en desarrollo y de pruebas E2E (3000 puede estar ocupado por otro servicio local)
# E2E_API_PORT=3100
# Con E2E_BASE_URL el E2E corre contra un stack ya levantado (por ejemplo docker compose: http://localhost:8090)
# E2E_BASE_URL=
# Puerto de la web en docker compose
# WEB_PORT=8090
